# 运行产物
raw/
.cache/
work/
tmp/
.tmp/

# 探针证据（只在 p0-artifacts 分支上用 -f 提交）
/p0/

# WorkBuddy 的会话记忆（.workbuddy/memory/）：本地工作笔记，不是交付物，
# 也不该出现在仓库的历史里。撤销跟踪的提交留给历史，之后不再新增。
.workbuddy/

# Python
__pycache__/
*.pyc
.venv/
venv/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 资源链路（scripts/azl_assets.py）
# assets-state.json 必须进 git —— 它是「哪些资源已产出、md5 多少」的唯一判据，
# 丢了就等于下一轮把上万个资源全部重下重解。
# bundle 缓存是几个 GB 的中间产物，清单是每轮重新生成的，都不能进。
.azl/bundles/
.azl/*.list
.azl/*.lst

